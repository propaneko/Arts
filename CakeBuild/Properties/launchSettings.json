{
  "profiles": {
    "Package All": {
      "commandName": "Project",
      "commandLineArgs": "--in=$(ModDeployRoot) --vs=$(VintageStoryPath)"
    },
    "Package Arts Series": {
      "commandName": "Project",
      "commandLineArgs": "--in=$(ModDeployRoot) --vs=$(VintageStoryPath) --projects=CoreOfArts,ArtOfGrowing,ArtOfCooking,AOGBreedingAddon"
    },
    "Client": {
      "commandName": "Executable",
      "executablePath": "$(VintageStoryPath)/Vintagestory.exe",
      "commandLineArgs": "--tracelog --addModPath=$(ModDeployRoot) --dataPath=$(VSDataPath)",
      "workingDirectory": "$(VintageStoryPath)"
    },
    "Server": {
      "commandName": "Executable",
      "executablePath": "$(VintageStoryPath)/VintagestoryServer.exe",
      "commandLineArgs": "--tracelog --addModPath=$(ModDeployRoot) --dataPath=$(VSDataPath)",
      "workingDirectory": "$(VintageStoryPath)"
    }
  }
}
