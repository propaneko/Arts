<Project>
    <PropertyGroup Label="DefaultBuildPropsValues">
        <VintageStoryPath>$(VINTAGE_STORY)</VintageStoryPath>
        <VSDataPath>$(APPDATA)VintagestoryData</VSDataPath>
        <ModDeployRoot>$(APPDATA)VintagestoryData\Mods</ModDeployRoot>
    </PropertyGroup>
    
    <!-- Mod developers' local overrides, if present -->
    <Import Label="LocalBuildPropsOverrides"
            Project="$(SolutionDir)/dev/Local.Build.props"
            Condition="Exists('$(SolutionDir)/dev/Local.Build.props')"/>
</Project>